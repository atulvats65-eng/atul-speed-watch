# Firebase (required for the database backend). In sab ko bharo to app Firebase
# Auth + Firestore use karegi aur saara data (orders, users, balances,
# transactions, SMM config) cloud par sync hoga.
# Agar ye khali rahein to app sirf localStorage ke saath chalti rahegi.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

