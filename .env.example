# Supabase (required for the cloud backend). In sab ko bharo to app Supabase
# Auth (Google login) + tables use karegi aur saara data (orders, users,
# services, transactions, SMM config) cloud par sync hoga (cross-device).
# Agar ye khali rahein to app sirf localStorage ke saath chalti rahegi.
#
# Supabase Dashboard → Settings → API se lo:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Google OAuth chalu karne ke liye: Supabase Dashboard → Authentication →
# Providers → Google (Client ID + Client Secret set karo).
#
# Server-side provider dispatcher (Phase 2 / R1). Isko sirf "true" karo jab:
#   1. owner-RLS migration (supabase/migration_owner_rls.sql) apply ho
#   2. Supabase Auth on ho
#   3. Edge Function (supabase/functions/dispatch) deploy ho
#   4. pg_cron schedule bana ho
# Tab tak orders hamesha SIMULATION mode me chalenge (provider ko nahi jaate).
VITE_DISPATCH_READY=false


