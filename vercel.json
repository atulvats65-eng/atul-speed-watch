{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/smm.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/smm",
      "destination": "/api/smm"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
