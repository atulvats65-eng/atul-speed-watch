rules_version = '2';

// ATUL Speed Watch — Firestore security rules.
// Note: this panel currently stores data in top-level collections without a
// per-user separation (the dashboard is a single shared panel). Adjust the
// `allow read/write` conditions to your access model. The examples below allow
// all authenticated users to read/write — tighten them for production.

service cloud.firestore {
  match /databases/{database}/documents {

    // Orders (all users share the panel)
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // User records (key, name, balance, active status)
    match /users/{userKey} {
      allow read, write: if request.auth != null;
    }

    // Transactions (deposits / order charges / refunds)
    match /transactions/{txId} {
      allow read, write: if request.auth != null;
    }

    // SMM API config (single doc "settings")
    match /apiConfig/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
